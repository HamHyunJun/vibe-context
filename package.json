{
  "name": "vibe-context",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first context layer for AI coding tools (MCP server + dashboard)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @vibe-context/server dev",
    "start:server": "pnpm --filter @vibe-context/server start",
    "inspect:server": "pnpm --filter @vibe-context/server inspect",
    "smoke:server": "pnpm --filter @vibe-context/server smoke",
    "db:generate": "pnpm --filter @vibe-context/server db:generate",
    "db:migrate": "pnpm --filter @vibe-context/server db:migrate",
    "db:studio": "pnpm --filter @vibe-context/server db:studio"
  }
}
